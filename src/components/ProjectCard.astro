---
interface Props {
  title: string;
  description: string;
  tags: string[];
  link?: string;
}

const { title, description, tags, link = "#" } = Astro.props;
---

<article class="p-6 rounded-xl border border-border bg-background-card hover:border-border-hover transition-all duration-300">
  <h3 class="text-xl text-foreground font-medium mb-3">
    {title}
  </h3>
  <p class="text-foreground-muted text-sm leading-relaxed mb-5">
    {description}
  </p>
  <div class="flex flex-wrap gap-2 mb-5">
    {tags.map(tag => (
      <span class="text-xs px-2.5 py-1 rounded-full bg-accent-soft text-accent">
        {tag}
      </span>
    ))}
  </div>
  <a href={link} class="text-sm text-accent hover:text-accent-hover transition">
    View Project →
  </a>
</article>
