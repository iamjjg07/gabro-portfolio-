---
import ResumeButtons from './ResumeButtons.astro';

const base = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : import.meta.env.BASE_URL + '/';
---

<section id="home" class="min-h-[90vh] flex items-center pt-24 pb-16">
  <div class="max-w-5xl mx-auto px-6 w-full">
    <div class="flex flex-col md:flex-row items-center gap-10 md:gap-16">
      
      <!-- Profile Image -->
      <div class="flex-shrink-0">
        <img
          src={`${base}image/portrait.jpg`}
          alt="Gabro Joy Jimwea"
          class="w-48 h-48 md:w-56 md:h-56 rounded-full object-cover border-4 border-amber-500/30 shadow-xl"
        />
      </div>

      <!-- Text Content -->
      <div>
        <p class="text-accent font-medium tracking-wide mb-4">
          Physics with Electronics
        </p>
        
        <h1 class="font-serif text-5xl md:text-6xl lg:text-7xl text-yellow-400 leading-tight mb-6">
          Gabro Joy Jimwea
        </h1>
        
        <p class="text-xl text-foreground-muted max-w-2xl mb-10 leading-relaxed">
          I study Physics with Electronics and I'm diving into the world of web development. Currently learning HTML and CSS and excited to build cool stuff for the web.
        </p>

        <ResumeButtons />
      </div>
    </div>
  </div>
</section>
