---
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
---

<section id="projects" class="py-24">
  <div class="max-w-5xl mx-auto px-6">
    <h2 class="text-sm font-medium tracking-widest text-accent uppercase mb-4">
      Projects
    </h2>
    <h3 class="font-serif text-3xl md:text-4xl text-foreground mb-12">
      Things I'm building
    </h3>

    <div class="grid md:grid-cols-2 gap-6">
      {projects.map(project => (
        <ProjectCard {...project} />
      ))}
    </div>
  </div>
</section>
