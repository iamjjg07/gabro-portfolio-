---
import ResumeButtons from './ResumeButtons.astro';
---

<section id="contact" class="py-24 bg-white/[0.02]">
  <div class="max-w-5xl mx-auto px-6">
    <h2 class="text-sm font-medium tracking-widest text-amber-500 uppercase mb-4">
      Contact
    </h2>
    <h3 class="font-serif text-3xl md:text-4xl text-stone-100 mb-6">
      Let’s connect
    </h3>
    <p class="text-stone-400 max-w-xl mb-10">
      Open to opportunities in electronics, applied physics, and technical roles. Feel free to reach out.
    </p>

    <div class="flex flex-col sm:flex-row gap-8 mb-12">
      <div>
        <p class="text-sm text-stone-500 mb-1">Phone</p>
        <a href="tel:+2349021360941" class="text-stone-200 hover:text-amber-400 transition">
          0902 136 0941
        </a>
      </div>
      <div>
        <p class="text-sm text-stone-500 mb-1">Email</p>
        <a href="mailto:your.email@example.com" class="text-stone-200 hover:text-amber-400 transition">
          gabrojoy@gmail.com
        </a>
      </div>
    </div>

    <ResumeButtons />
  </div>
</section>
